          </div>
        </div>

        <div class="left-section">
          <div class="left-section-content-wrapper">
            <form class="sign-up-form-wrapper" id="forgotPasswordForm" action="/auth/forgot-password/" method="post">
              <div class="title-section title-section-signup">
                <div class="title create-account-title" id="forgotPasswordTitle">Forgot your password?</div>
                <div class="title-subtitle">No worries! We'll send you a reset link</div>
              </div>

              <div class="input-fields-wrapper">
                <div class="input-wrapper">
                  <label class="label" for="email">Email / WhatsApp no.</label>
                  <div class="input-field email-input">
                    <div class="dropdown-wrapper">
                      <div class="dropdown-container" tabindex="-1">
                        <div class="dropdown-toggle" id="dropdown-toggle">
                          <div class="dropdown-selected-option">
                            <img src="https://flagcdn.com/w320/in.png" alt="" id="dropdownItemImg" />
                            <span id="dropdownItemText">+91</span>
                            <div class="dropdown-arrow-icon show-dropdown-arrow-icon" id="dropdownDownArrow">
                              <svg xmlns="http://www.w3.org/2000/svg" width="8" height="5" viewBox="0 0 8 5" fill="none">
                                <path d="M4.00338 4.5C3.85221 4.5 3.70104 4.44431 3.5817 4.32496L0.773146 1.51641C0.542415 1.28568 0.542415 0.903779 0.773146 0.673048C1.00388 0.442317 1.38578 0.442317 1.61651 0.673048L4.00338 3.05992L6.39025 0.673048C6.62098 0.442317 7.00288 0.442317 7.23361 0.673048C7.46434 0.903779 7.46434 1.28568 7.23361 1.51641L4.42506 4.32496C4.30572 4.44431 4.15455 4.5 4.00338 4.5Z" fill="#6B7280"/>
                              </svg>
                            </div>
                            <div class="dropdown-arrow-icon" id="dropdownUpArrow">
                              <svg xmlns="http://www.w3.org/2000/svg" width="8" height="5" viewBox="0 0 8 5" fill="none">
                                <path d="M4.00338 0.5C3.85221 0.5 3.70104 0.555694 3.5817 0.675038L0.773146 3.48359C0.542415 3.71432 0.542415 4.09622 0.773146 4.32695C1.00388 4.55768 1.38578 4.55768 1.61651 4.32695L4.00338 1.94008L6.39025 4.32695C6.62098 4.55768 7.00288 4.55768 7.23361 4.32695C7.46434 4.09622 7.46434 3.71432 7.23361 3.48359L4.42506 0.675038C4.30572 0.555694 4.15455 0.5 4.00338 0.5Z" fill="black"/>
                              </svg>
                            </div>
                          </div>
                        </div>
                        <div class="dropdown-menu" id="dropdown-menu">
                          <div class="input-wrapper dropdown-menu-search">
                            <span class="label">Country code</span>
                            <div class="input-field">
                              <input type="search" placeholder="Search" id="dropdownItemsSearch" />
                            </div>
                          </div>
                          <div class="dropdown-items-wrapper"></div>
                        </div>
                      </div>
                    </div>
                    <div class="overlay"></div>

                    <input
                      id="email"
                      type="text"
                      placeholder="Enter your work email or WhatsApp number"
                      class="base-input"
                      name="email"
                      value="<%= emailOrPhone || '' %>"
                    />
                  </div>
                  <div class="error-msg-feild" id="errorTextContainer">
                    <span id="errorTextMessage">*Invalid Email / WhatsApp no.</span>
                  </div>
                  <div class="error-msg-feild-2 <%= message ? '' : 'hidden' %>" id="message"><%= message || '' %></div>
                </div>

                <input id="countryCode" type="hidden" class="base-input" name="countryCode" value="<%= countryCode || '+91' %>" />

                <div class="primary-button-wrapper" id="sendResetLink">
                  <button class="primary-button" type="submit" id="sendResetLinkButton">Send reset link</button>
                </div>
              </div>

              <div class="have-account">
                Back to
                <a href="/login">Login</a>
              </div>
              <input type="hidden" name="interactionId" value="<%= uuid || '' %>" id="interactionId" />
              <input type="hidden" name="clientId" value="<%= clientId || '' %>" id="clientId" />
            </form>
          </div>
        </div>

        <div class="right-section">
          <div class="login-slider-wrapper image-wrapper" id="forgotImageSlider">
            <img class="login-slide is-active" src="/assets/login-1.png" alt="Slide 1" />
            <img class="login-slide" src="/assets/login-2.png" alt="Slide 2" />
            <img class="login-slide" src="/assets/login-3.png" alt="Slide 3" />
          </div>
        </div>
      </div>
    </div>

    <script src="/js/forgotpassword.js" type="module" defer></script>
  </body>
</html>
