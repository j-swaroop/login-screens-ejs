                                </div>
                            </div>
                            <div class="login-via-option">
                                <div class="image-wrapper">
                                    <img src="assets/facebookLogo.png" alt="" />
                                </div>
                            </div>
                            <div class="login-via-option">
                                <div class="image-wrapper">
                                    <img src="assets/microsoftLogo.png" alt="" />
                                </div>
                            </div> -->
                        </div>
                        <div class="or-login-with">
                            <hr>
                            </hr>
                            <%=content_or%>
                                <hr>
                                </hr>
                        </div>
                    </div>
                    <form id="signupForm" class="form-wrapper"
                        action="/oauth2/v1/interaction/<%= details.uuid %>/signup" method="post"
                        onsubmit="return validateForm('onsubmit')" autocomplete="off">
