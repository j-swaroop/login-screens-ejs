                                    <img src="/assets/googleLogo.png" alt="" />
                                </div>
                                Sign up with Google
                            </div>
                            <!-- <div class="login-via-option" id="googleBTN" onclick="googleclick();">
                                <div class="image-wrapper">
                                    <img src="/assets/googleLogo.png" alt="" />
                                </div>
                            </div> -->
