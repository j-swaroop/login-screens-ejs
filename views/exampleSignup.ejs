                                <%=content_alreadyHaveAccount%>
                                    <a class="cta-v2" onclick="location.href=redirect('<%=clientId%>')">
                                        <%=content_signIn%>
                                    </a>
                            </div>
                            <div class="cta-tag">
                                <%=content_bySigningup%> <a class="link" href="https://foyr.com/terms-conditions/"
                                        target="_blank">
