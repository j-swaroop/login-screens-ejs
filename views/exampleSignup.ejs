<% const loginUrl='/oauth2/v1/interaction/' + details.uuid+'/login' %>

    <body onload="defaultEye('<%=clientId%>')">
        <script>

            function redirect(client) {

                if (client == 'foyrcommunitydev') {
                    return 'https://accountsdevgcp.foyr.com/oauth2/v1/auth?client_id=foyrcommunitydev&scope=openid%20profile&response_type=code&redirect_uri=https://communitystaging.foyr.com/callback/&state=4zMhyYUXoW'
                }

                if (client == 'foyrboost') {
                    return 'https://accountsdevgcp.foyr.com/oauth2/v1/auth?client_id=foyrboost&scope=openid%20profile&response_type=code&redirect_uri=https://booststaging.foyr.com/callback/&state=4zMhyYUXoW'
                }

                return "https://accountsdevgcp.foyr.com/oauth2/v1/auth?client_id=neostaging&scope=openid%20profile&response_type=code&redirect_uri=https://neostaging.foyr.com/login/callback&state=eyJzdGF0ZSI6Imh0dHBzOi8vbmVvc3RhZ2luZ2djcC5mb3lyLmNvbS9sb2dpbi9jYWxsYmFjayJ9"
            }

            const emailRegex = /(?:[a-zA-Z0-9!#$%&'*+/=?^_`{|}~-]+(?:\.[a-zA-Z0-9!#$%&'*+/=?^_`{|}~-]+)*|"(?:[\x01-\x08\x0b\x0c\x0e-\x1f\x21\x23-\x5b\x5d-\x7f]|\\[\x01-\x09\x0b\x0c\x0e-\x7f])*")@(?:(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?\.)+[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?|\[(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?|[a-zA-Z0-9-]*[a-zA-Z0-9]:(?:[\x01-\x08\x0b\x0c\x0e-\x1f\x21-\x5a\x53-\x7f]|\\[\x01-\x09\x0b\x0c\x0e-\x7f])+)\])/;
            const language = '<%=language%>'
            const checkYourMail = '<%=content_checkYourMail%>'
            const sentCode = '<%=content_sentCode%>'
            const allFieldsRequired = '<%=content_allFieldsRequired%>'
            const emailRegisteredAlready = '<%=content_emailRegisteredAlready%>'
            const passwordError = '<%=content_passwordError%>'
            let client = null

            const fullNameRegex = /^[a-zA-Z][a-zA-Z0-9 ]+$/
            let step = 1
            let disabled = true
            let otp = ''
            const defaultEye = function (clientId) {

                client = clientId

                let heading = document.getElementById("heading")
                // let steps = document.getElementById("steps")
                let subHeading = document.getElementById("sub-heading")

                // if (["foyrcommunitydev", "foyrcommunity"].indexOf(client) >= 0) {
                //     steps.innerHTML = "Step 1 of 2"
                // }

                if (["foyrboost"].indexOf(client) >= 0) {
                    subHeading.style.display = 'none'
                }

                if (window.analytics) {
                    window.analytics.track('signupstep1_shown', {
                        title: 'Sign up page is shown',
                        subtitle: 'Sign up page is shown',
                    }, {
                        'integrations': {
                            "Amplitude": {
                                "session_id": new Date().getTime()
                            }
                        }
                    }, { "timestamp": new Date().getTime() });
                }

                document.getElementById("hidden-eye").style.display = "block";
                document.getElementById("show-eye").style.display = "none";

            }

            const googleclick = function () {
                if (window.analytics) {
                    window.analytics.track('signupgoogle_clicked', {
                        title: 'user clicked on sign up with google button',
                        subtitle: 'sign up using google',
                    }, {
                        'integrations': {
                            "Amplitude": {
                                "session_id": new Date().getTime()
                            }
                        }
                    }, { "timestamp": new Date().getTime() });
                }
            }

            function debounce(func, timeout = 1000) {
                let timer;
                return (...args) => {
                    clearTimeout(timer);
                    timer = setTimeout(() => { func.apply(this, args); }, timeout);
                };
            }

            const KeyUpValidation = debounce((e) => checkKeys(e));
            const nameValidation = debounce((e) => validateForm());

            const showPassword = function () {
                var x;
                x = document.getElementById("password-input");
                if (x.type === "password") {
                    document.getElementById("hidden-eye").style.display = "none";
                    document.getElementById("show-eye").style.display = "block";
                    x.type = "text";
                    showEye = true;
                } else {
                    x.type = "password";
                    document.getElementById("hidden-eye").style.display = "block";
                    document.getElementById("show-eye").style.display = "none";
                    showEye = false;
                }
            }

            function emailValidation() {
                return new Promise((resolve, reject) => {

                    let value = document.getElementById("email-input").value
                    let message = document.getElementById("message")

                    if (emailRegex.test(value)) {

                        isEmailRegistered(value, function (error, response) {

                            if (response.data) {
                                message.classList.remove("hidden")
                                message.innerText = emailRegisteredAlready
                                return resolve(true)
                            }

                            if (message.className.indexOf('hidden') === -1) {
                                message.classList.add("hidden")
                            }

                            return resolve(false)

                        })

                    } else if (!value) {
                        message.classList.remove("hidden")
                        message.innerText = allFieldsRequired
                        return resolve(true)
                    } else {
                        message.classList.remove("hidden")
                        message.innerText = "That format doesn't look right. Make sure there aren't any typos"
                        return resolve(true)
                    }

                })
            }

            function passwordValidation() {
                let password = document.getElementById('password-input').value
                let errorMessage = document.getElementById('message')
                if (!password) {
                    errorMessage.classList.remove("hidden")
                    errorMessage.innerText = allFieldsRequired
                    return true
                } else if (password.length < 6) {
                    errorMessage.className = errorMessage.className.replace('hidden', '')
                    errorMessage.innerHTML = passwordError
                    return true
                }
            }

            async function checkKeys(e, callback) {

                let message = document.getElementById("message")
                let submitButton = document.getElementById('signUp-button')

                let isEmailValid = await emailValidation()

                if (isEmailValid) {
                    return callback(true)
                }

                let isNameInValid = nameValidator()

                if (isNameInValid) {
                    return callback(true)
                }

                let isPasswordInValid = passwordValidation()

                if (isPasswordInValid) {
                    return callback(true)
                }

                if (e && e.keyCode == 13) {
                    e.preventDefault();
                    return callback(false);
                }

                return callback(false)

            }

            function nameValidator() {

                let value = document.getElementById("fullName").value
                let message = document.getElementById("message")
                let submitButton = document.getElementById('signUp-button')

                if (['JP', 'SP'].includes(language) || fullNameRegex.test(value)) {
                    if (message.className.indexOf('hidden') === -1) {
                        message.classList.add("hidden")
                    }
                    return false
                } else if (!value) {
                    if (message.className.indexOf('hidden') === -1) {
                        message.classList.add("hidden")
                    }
                    return true
                } else {
                    message.classList.remove("hidden")
                    message.innerText = "Pssst! Please re-enter your name without using any special characters"
                    return true
                }

            }

            function clickNext() {
                checkKeys(null, (isInValid) => {

                    if (isInValid) {
                        return
                    }
                    if (window.analytics) {
                        window.analytics.track('signupemailnext_clicked', {
                            title: 'user typed the email id and then clicked on the next button',
                            subtitle: 'sign up using the user email id',
                        }, {
                            'integrations': {
                                "Amplitude": {
                                    "session_id": new Date().getTime()
                                }
                            }
                        }, { "timestamp": new Date().getTime() });
                    }

                    onOTPVerification()

                })
            }

            function hideSignInWithGoogle() {
                document.getElementsByClassName("fyr_cauth_pup12")[0].classList.add("hidden")
            }

            function hideOr() {
                document.getElementsByClassName("fyr_cauth_pup13")[0].classList.add("hidden")
            }

            function showSignInWithGoogle() {
                document.getElementsByClassName("fyr_cauth_pup12")[0].classList.remove("hidden")
            }

            function showName() {
                document.getElementById("fullName").classList.remove("hidden");
            }

            function showPassWord() {
                document.getElementById("password").classList.remove("hidden");
            }

            function showPasswordText() {
                if (document.querySelector("#password input").type == "password")
                    document.querySelector("#password input").type = "text"
                else if (document.querySelector("#password input").type == "text")
                    document.querySelector("#password input").type = "password"
            }

            const validateForm = function (type) {

                let password = document.getElementById('password-input').value
                let name = document.getElementById('fullName').value
                let errorMessage = document.getElementById('message')
                let submitButton = document.getElementById('signUp-button')

                let isNameInValid = nameValidator()

                if (isNameInValid) {
                    if (submitButton.className.indexOf('disable') === -1) {
                        submitButton.classList.add("disable")
                        submitButton.disabled = true;
                    }
                    return false
                }

                if (!name || !password) {
                    errorMessage.innerHTML = allFieldsRequired
                    errorMessage.className = errorMessage.className.replace('hidden', '')
                    if (submitButton.className.indexOf('disable') === -1) {
                        submitButton.classList.add("disable")
                        submitButton.disabled = true;
                    }
                    return false
                } else if (password.length < 6) {
                    errorMessage.className = errorMessage.className.replace('hidden', '')
                    errorMessage.innerHTML = passwordError
                    if (submitButton.className.indexOf('disable') === -1) {
                        submitButton.classList.add("disable")
                        submitButton.disabled = true;
                    }
                    return false
                } else {

                    if (type == 'onsubmit') {

                        submitButton.classList.add("disable")
                        submitButton.disabled = true;

                        if (window.analytics) {
                            window.analytics.track('signupstep2_clicked', {
                                title: 'user filled up his name and password',
                                subtitle: 'completed the step 2 of the sign up flow',
                            }, {
                                'integrations': {
                                    "Amplitude": {
                                        "session_id": new Date().getTime()
                                    }
                                }
                            }, { "timestamp": new Date().getTime() });
                        }

                    } else {

                        errorMessage.innerHTML = ''

                        if (errorMessage.className.indexOf('hidden') === -1) {
                            errorMessage.classList.add("hidden")
                        }

                        submitButton.classList.remove("disable")
                        submitButton.disabled = false;

                        return true

                    }

                }
            }

            function checkEnter(e) {
                e = e || event;
                if (e.keyCode == 13) {
                    e.preventDefault();
                    return false;
                }
            }

            const avoidSpace = function (event, type = null) {

                const k = event ? event.which : window.event.keyCode;
                const name = document.getElementById("fullName").value

                if (k == 32 && type == 'name' && name.length > 0) {
                    return true
                }

                if (k == 32) return false;

            }

            function onSignIn(googleUser) {
                googleclick()
                var authResponse = googleUser.getAuthResponse();
                window.open(`<%-details.googleUrl%>&code=${authResponse.id_token}`, '_self')
            }

            gapi.load('auth2', function () {
                // Retrieve the singleton for the GoogleAuth library and set up the client.
                auth2 = gapi.auth2.init({
                    client_id: '46521551054-dq2dd588gmoirnbdu5th5s74agfid1v6.apps.googleusercontent.com',
                    cookiepolicy: 'single_host_origin',
                    // Request scopes in addition to 'profile' and 'email'
                    //scope: 'additional_scope'
                });
                auth2.attachClickHandler(document.getElementById('googleBTN'), {}, onSignIn);
            });

            function onOTPVerification() {
                const email = document.getElementById("email-input").value
                document.getElementById('signUp-button').classList.add("disable")
                document.getElementById('signUp-button').disabled = true;
                return document.getElementById('signupForm').submit();
            }

        </script>
